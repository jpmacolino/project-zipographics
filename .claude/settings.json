{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(bat *.env*)",
      "Bash(nl *.env*)",
      "Bash(od *.env*)",
      "Bash(xxd *.env*)",
      "Bash(strings *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(findstr *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(cp *.env*)",
      "Bash(copy *.env*)",
      "Bash(mv *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(gc *.env*)",
      "Bash(Select-String *.env*)",
      "Bash(powershell *.env*)",
      "Bash(pwsh *.env*)",
      "Bash(cmd *.env*)",
      "Bash(code *.env*)",
      "Bash(notepad *.env*)",
      "Bash(echo $CENSUS_API_KEY*)",
      "Bash(echo %CENSUS_API_KEY%*)",
      "Bash(echo $env:CENSUS_API_KEY*)",
      "Bash(printenv CENSUS_API_KEY*)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(set)",
      "Bash(Get-ChildItem env*)",
      "Bash(gci env*)",
      "Bash(dir env*)",
      "Bash(ls env*)",
      "Bash(dotenv *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add .env*)"
    ],
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv python:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git config user.email)",
      "Bash(git config user.name)",
      "Bash(git config --get:*)",
      "Bash(git show:*)",
      "Bash(git tag:*)",
      "WebFetch(domain:www.census.gov)",
      "WebFetch(domain:www2.census.gov)",
      "WebFetch(domain:api.census.gov)",
      "WebFetch(domain:data.census.gov)",
      "WebFetch(domain:docs.streamlit.io)",
      "WebFetch(domain:geopandas.org)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(git remote:*)",
      "Bash(git config --global:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)"
    ]
  }
}
