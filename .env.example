# Census Data API key: needed ONLY by the data build script (scripts/build_data.py), never by the app.
# Get a free key at https://www.census.gov/data/developers/api-key.html
# (activate it from the email; the address must end in .com, .net, .org, .gov or .edu).
# Copy this file to .env and paste the key after the equals sign. Never commit .env.
CENSUS_API_KEY=
